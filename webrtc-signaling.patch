+export async function xcallsBatch(req: Request, v: Viewer): Promise<Response> {
+	let body: any;
+	try {
+		body = await req.json();
+	} catch {
+		return Response.json({ error: "Invalid batch." }, { status: 400 });
+	}
+	const items: any[] = Array.isArray(body?.items) ? body.items.slice(0, 20) : [];
+	const ids: Record<string, string> = {};
+	const lines: string[] = [];
+	for (const [index, item] of items.entries()) {
+		const started = Date.now();
+		const path = String(item?.path ?? "");
+		const handler = path.startsWith(CALLING_PREFIX) ? CALLING_RPC[path.slice(CALLING_PREFIX.length)] : undefined;
+		let status = "OK";
+		let out: any = {};
+		if (!handler) status = "UNIMPLEMENTED";
+		else {
+			try {
+				out = await handler(v, item?.body && typeof item.body === "object" ? item.body : {});
+				const result: any = Object.values(out ?? {})[0];
+				const id = result?.call?.call_id ?? result?.room_id;
+				if (typeof id === "string") ids[`$${index}`] = id;
+			} catch (e) {
+				if (!(e instanceof ChatError)) throw e;
+				status = "FAILED_PRECONDITION";
+				out = { message: e.message };
+			}
+		}
+		lines.push(JSON.stringify({ type: "item", index, status, ms: Date.now() - started, body: out }));
+	}
+	lines.push(JSON.stringify({ type: "done", batch_id: typeof body?.batch_id === "string" ? body.batch_id.slice(0, 128) : "", ids, error: null }));
+	return new Response(`${lines.join("\n")}\n`, { headers: { "content-type": "application/x-ndjson", "cache-control": "no-cache" } });
